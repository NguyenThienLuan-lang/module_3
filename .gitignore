.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# ==========================================
# 2. Thư viện & Dependencies
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# 3. Bản dựng đóng gói (Build Outputs)
# ==========================================
dist/
build/
dist-ssr/
out/
coverage/
*.tsbuildinfo

# ==========================================
# 4. Nhật ký lỗi (Logs & Debugging)
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
